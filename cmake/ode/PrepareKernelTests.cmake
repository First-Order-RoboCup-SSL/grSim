file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(name fastlsolve_impl.h fastltsolve_impl.h fastdot_impl.h)
  execute_process(COMMAND "${GIT_EXECUTABLE}" show
    "a5fc0bc282703ab34d7d3d2500bafae7428eeaa9:ode/src/${name}"
    WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE reference)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot read pinned ODE kernel reference ${name}")
  endif()
  file(READ "${SOURCE_DIR}/ode/src/${name}" optimized)
  foreach(variant reference optimized)
    set(contents "${${variant}}")
    string(FIND "${contents}" "template<unsigned int block_step>" cooperative_start)
    if(NOT cooperative_start EQUAL -1)
      string(SUBSTRING "${contents}" 0 ${cooperative_start} contents)
      string(APPEND contents "\n#endif\n")
    endif()
    string(REGEX MATCH "#ifndef [A-Za-z0-9_]+" guard "${contents}")
    string(REPLACE "#ifndef " "" guard_name "${guard}")
    string(REPLACE "${guard_name}" "${guard_name}_${variant}" contents "${contents}")
    file(WRITE "${OUTPUT_DIR}/${variant}_${name}" "${contents}")
  endforeach()
endforeach()
